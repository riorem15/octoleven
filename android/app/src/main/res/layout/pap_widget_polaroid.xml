<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="8dp"
    android:gravity="center_horizontal">

    <!-- Polaroid Photo Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#E0E0E0">

        <ImageView
            android:id="@+id/widget_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Polaroid PAP" />

        <TextView
            android:id="@+id/widget_tag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="4dp"
            android:background="@drawable/badge_yellow"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:textColor="#25181A"
            android:textSize="9sp"
            android:textStyle="bold"
            android:text="Cafe ☕" />
    </FrameLayout>

    <!-- Polaroid Bottom Caption Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/widget_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#25181A"
            android:textSize="11sp"
            android:textStyle="italic|bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Manisnya hariku ❤️" />

        <TextView
            android:id="@+id/widget_sender_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AD2C4E"
            android:textSize="9sp"
            android:textStyle="bold"
            android:text="Pasangan • Baru saja" />
    </LinearLayout>

</LinearLayout>
