<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg_neo"
    android:padding="4dp">

    <!-- Left Side: Image with Overlay -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="match_parent">
        
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/widget_bg_rounded">
            <ImageView
                android:id="@+id/widget_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="PAP Image" />
        </FrameLayout>
        
        <!-- Sender Name Overlay Badge -->
        <TextView
            android:id="@+id/widget_sender_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_margin="8dp"
            android:background="@drawable/badge_solid_pink"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="10sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Pasangan ❤️" />
    </RelativeLayout>

    <!-- Right Side: Details -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_weight="1.2"
        android:layout_height="match_parent"
        android:padding="12dp">

        <!-- Top Header -->
        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentTop="true">
            
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="#ad2c4e"
                android:textStyle="bold"
                android:textSize="12sp"
                android:text="❤️ Octoleven" />
                
            <TextView
                android:id="@+id/widget_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_yellow"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="9sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Baru saja" />
        </LinearLayout>

        <!-- Caption -->
        <TextView
            android:id="@+id/widget_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/widget_header"
            android:layout_above="@+id/widget_footer"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:textColor="#111111"
            android:textStyle="bold"
            android:textSize="12sp"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="&quot;Belum ada PAP&quot;" />

        <!-- Bottom Footer -->
        <RelativeLayout
            android:id="@+id/widget_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true">
            
            <TextView
                android:id="@+id/widget_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/badge_pink"
                android:textColor="#ad2c4e"
                android:textStyle="bold"
                android:textSize="10sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="Spontan ✨" />

            <!-- Heart Button (Right) -->
            <ImageView
                android:id="@+id/widget_heart_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/badge_yellow"
                android:padding="6dp"
                android:contentDescription="Like Button" />
        </RelativeLayout>

    </RelativeLayout>
</LinearLayout>
