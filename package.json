{
  "name": "octoleven-couple-pap",
  "version": "1.0.0",
  "description": "Octoleven - Real-time Couple PAP & Native Android App (Supabase Backend)",
  "main": "server.js",
  "scripts": {
    "build": "node -e \"const fs=require('fs'); fs.mkdirSync('www', {recursive:true}); ['index.html','styles.css','app.js','supabase-config.js','manifest.json'].forEach(f=>fs.copyFileSync(f,'www/'+f));\"",
    "vercel-build": "node -e \"const fs=require('fs'); fs.mkdirSync('www', {recursive:true}); ['index.html','styles.css','app.js','supabase-config.js','manifest.json'].forEach(f=>fs.copyFileSync(f,'www/'+f));\"",
    "sync": "npm run build && npx cap sync android",
    "open:android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "^8.0.3",
    "firebase-admin": "^14.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0"
  }
}
